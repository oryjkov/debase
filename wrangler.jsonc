{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "debase",
  "compatibility_date": "2026-08-08",
  "assets": { "directory": "web" },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "debase.ch", "custom_domain": true },
    { "pattern": "www.debase.ch", "custom_domain": true }
  ]
}
